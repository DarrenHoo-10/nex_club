{
  "id": "content",
  "transport": "stdio",
  "command": "/opt/nex-club-mcp/api",
  "args": ["mcp-bridge", "/run/nex-club-mcp/mcp.sock"],
  "cwd": "/",
  "envFrom": {},
  "timeoutMs": 15000,
  "allowTools": [
    "mcp_list",
    "resources_list",
    "resource_get",
    "tags_list",
    "automation_status",
    "material_read",
    "url_read",
    "action_get"
  ],
  "enabled": true
}
