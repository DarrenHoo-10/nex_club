# Copy to .env and fill in. Do not commit .env.

# Runtime login must inherit nex_app and must not own tables.
NEX_DATABASE_URL=postgres://nex_runtime:replace-password@127.0.0.1:54329/nex_club?sslmode=disable
# Set only for nexadm migrate, in a separate shell/process:
# NEX_MIGRATION_DATABASE_URL=postgres://migration-owner:replace-password@127.0.0.1:54329/nex_club?sslmode=disable
NEX_HTTP_ADDR=:8080
NEX_PUBLIC_BASE_URL=http://localhost:5173
NEX_SESSION_SECRET=replace-with-32-or-more-random-bytes
NEX_CURSOR_SECRET=replace-with-base64-of-32-random-bytes
NEX_CURSOR_KEY_ID=k1
NEX_CURSOR_PREVIOUS_KEYS={}
NEX_ENVIRONMENT=development
NEX_PUBLIC_INCLUDE_DEMO=true
NEX_MODEL_ENABLED=false
NEX_MODEL_FIXTURE=false
# NEX_MODEL_BASE_URL=https://api.openai.com/v1
# NEX_MODEL_NAME=gpt-4.1-mini
# NEX_MODEL_API_KEY=
# NEX_MODEL_CURRENCY=USD
# NEX_MODEL_DAILY_LIMIT=20
# NEX_MODEL_INPUT_PER_TOKEN=0.00000500
# NEX_MODEL_OUTPUT_PER_TOKEN=0.00001500
# NEX_STATIC_DIR=dist

# Used only by: nexadm admin init
# NEX_ADMIN_USERNAME=
# NEX_ADMIN_PASSWORD=

# Paid collection channels (optional). Leave budgets at zero to disable paid requests.
# SocialData uses USD; configure PRICE_PER_POST from your own provider price card.
SOCIALDATA_API_KEY=
NEX_SOCIALDATA_DAILY_LIMIT=0
NEX_SOCIALDATA_MAX_REQUEST_COST=0
NEX_SOCIALDATA_PRICE_PER_POST=0
# Dajiala uses CNY and reports actual cost_money for list/body requests.
DAJIALA_KEY=
NEX_DAJIALA_DAILY_LIMIT=0
NEX_DAJIALA_MAX_REQUEST_COST=0
